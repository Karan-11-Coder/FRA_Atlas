# Copy to .env (never commit .env). docker compose reads it.

# REQUIRED. Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=120

# Demo data (SEED_DEMO=1 seeds a demo officer, villages and sample claims on start).
SEED_DEMO=1
DEMO_OFFICER_USERNAME=demo.officer@example.org
# Leave empty to have a random password generated and printed ONCE in the backend log.
DEMO_OFFICER_PASSWORD=

# Where the browser reaches the backend (baked into the frontend build), and
# which frontend origins the backend accepts. Change both together.
NEXT_PUBLIC_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: SMS OTP for tribal-claimant login. Placeholder values are
# detected and OTPs are only printed to the backend log (dev mode).
MSG91_API_KEY=your_real_msg91_key_here
MSG91_SENDER_ID=FRAOTP
MSG91_TEMPLATE_ID=your_template_id_here
