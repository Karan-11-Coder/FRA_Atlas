# Optional settings for `docker compose up`. Copy to .env to change any of them
# (never commit .env). Everything has a sensible default, so this file is optional.

# Seed 16 reference villages and 14 demo claims on first start (idempotent).
SEED_DEMO=1

# Look up coordinates for new villages on OpenStreetMap Nominatim (needs internet).
GEOCODE_VILLAGES=1

# Where the browser reaches the backend (built into the frontend, so rebuild after
# changing it), and which dashboard origins the backend accepts. Change both together.
NEXT_PUBLIC_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Tesseract language packs for OCR (e.g. eng+hin if installed) and PDF raster DPI.
TESS_LANG=eng
PDF_DPI=300
