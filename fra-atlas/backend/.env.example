# Optional backend settings for running without Docker (copy to backend/.env).
# Everything has a default; the dashboard has no authentication, so there are no secrets.

# SQLite file (default: backend/fra_atlas.db)
# DATABASE_URL=sqlite+aiosqlite:///C:/path/to/fra_atlas.db

# Dashboard origins allowed to call the API
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Look up coordinates for new villages on OpenStreetMap Nominatim (1 = on)
# GEOCODE_VILLAGES=1

# OCR: Poppler location on Windows (pdf2image), Tesseract languages, raster DPI
# POPPLER_PATH=C:/poppler/Library/bin
# TESS_LANG=eng
# PDF_DPI=300
